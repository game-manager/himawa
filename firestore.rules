rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function authenticated() { return request.auth != null; }
    function isSuspended(uid) {
      return authenticated()
        && exists(/databases/$(database)/documents/moderation/$(uid))
        && get(/databases/$(database)/documents/moderation/$(uid)).data.status == 'suspended';
    }
    function signedIn() { return authenticated() && !isSuspended(request.auth.uid); }
    function isAdmin() {
      return authenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isFriend(uid) {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(uid));
    }
    function follows(uid) {
      return signedIn() && exists(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid));
    }
    function isBlocked(uid) {
      return signedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocks/$(uid))
        || exists(/databases/$(database)/documents/users/$(uid)/blocks/$(request.auth.uid))
      );
    }
    function isGroupMember(groupId) {
      return signedIn() && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }
    function conversationOther(data) {
      return data.participants[0] == request.auth.uid ? data.participants[1] : data.participants[0];
    }
    function validAvatar(avatar) {
      return avatar is map
        && avatar.keys().hasOnly(['skin', 'hair', 'outfit', 'background'])
        && avatar.skin is string && avatar.hair is string
        && avatar.outfit is string && avatar.background is string;
    }
    function validMusic(data) {
      return !('music' in data) || (
        data.music is map
        && data.music.keys().hasOnly(['provider', 'trackId', 'url', 'title', 'artistName', 'thumbnailUrl', 'previewUrl'])
        && data.music.trackId is string
        && data.music.url is string
        && data.music.title is string
        && data.music.title.size() >= 1
        && data.music.title.size() <= 100
        && (!('artistName' in data.music) || (data.music.artistName is string && data.music.artistName.size() >= 1 && data.music.artistName.size() <= 100))
        && (
          (
            data.music.provider == 'spotify'
            && data.music.trackId.matches('^[A-Za-z0-9]{22}$')
            && data.music.url == 'https://open.spotify.com/track/' + data.music.trackId
            && !('previewUrl' in data.music)
            && (!('thumbnailUrl' in data.music) || (
              data.music.thumbnailUrl is string
              && data.music.thumbnailUrl.matches('^https://[A-Za-z0-9.-]+\\.(spotifycdn\\.com|scdn\\.co)/.*$')
            ))
          )
          || (
            data.music.provider == 'apple'
            && data.music.trackId.matches('^[0-9]{1,20}$')
            && data.music.url.matches('^https://(music|itunes)\\.apple\\.com/.*$')
            && data.music.artistName is string
            && data.music.artistName.size() >= 1
            && data.music.artistName.size() <= 100
            && (!('thumbnailUrl' in data.music) || (
              data.music.thumbnailUrl is string
              && data.music.thumbnailUrl.matches('^https://([A-Za-z0-9.-]+\\.)?mzstatic\\.com/.*$')
            ))
            && (!('previewUrl' in data.music) || (
              data.music.previewUrl is string
              && data.music.previewUrl.matches('^https://[A-Za-z0-9.-]*itunes\\.apple\\.com/.*$')
            ))
          )
        )
      );
    }
    function validProfile(uid) {
      return request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'friendCode', 'avatar', 'currentStatus', 'defaultStatusVisibility',
          'discoverable', 'bio', 'statusHidden', 'createdAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 12
        && request.resource.data.friendCode is string
        && request.resource.data.friendCode.size() == 6
        && validAvatar(request.resource.data.avatar);
    }
    function validAcceptedRequest(requestId, uid, friendUid) {
      let friendRequest = getAfter(/databases/$(database)/documents/friendRequests/$(requestId)).data;
      return friendRequest.status == 'accepted' && (
        (friendRequest.fromUid == uid && friendRequest.toUid == friendUid)
        || (friendRequest.fromUid == friendUid && friendRequest.toUid == uid)
      );
    }

    match /users/{uid} {
      allow get: if isAdmin() || isOwner(uid) || (isFriend(uid) && !isBlocked(uid));
      allow list: if isAdmin();
      allow create: if isOwner(uid) && validProfile(uid);
      allow update: if isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.friendCode == resource.data.friendCode
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(uid);

      match /friends/{friendUid} {
        allow read: if isOwner(uid);
        allow create: if signedIn()
          && (request.auth.uid == uid || request.auth.uid == friendUid)
          && request.resource.data.uid == friendUid
          && request.resource.data.requestId is string
          && validAcceptedRequest(request.resource.data.requestId, uid, friendUid);
        allow update: if false;
        allow delete: if signedIn() && (request.auth.uid == uid || request.auth.uid == friendUid);
      }

      match /blocks/{blockedUid} { allow read, create, update, delete: if isOwner(uid); }

      match /following/{targetUid} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && request.resource.data.uid == targetUid;
        allow delete: if isOwner(uid);
      }

      match /followers/{followerUid} {
        allow read: if isOwner(uid);
        allow create, update: if signedIn() && request.auth.uid == followerUid && request.resource.data.uid == followerUid;
        allow delete: if signedIn() && (request.auth.uid == followerUid || request.auth.uid == uid);
      }

      match /groups/{groupId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.groupId == groupId
          && existsAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(uid));
        allow delete: if isOwner(uid);
      }
    }

    match /publicProfiles/{uid} {
      allow get: if isAdmin() || (signedIn() && (resource.data.discoverable == true || isOwner(uid) || isFriend(uid) || follows(uid)));
      allow list: if isAdmin();
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 12
        && validAvatar(request.resource.data.avatar)
        && request.resource.data.discoverable is bool;
      allow delete: if isOwner(uid);
    }

    match /statusShares/{uid} {
      allow get: if signedIn() && !isBlocked(uid) && (isOwner(uid) || isFriend(uid));
      allow list: if false;
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 60
        && request.resource.data.emoji is string
        && request.resource.data.visibility == 'friends'
        && request.resource.data.expiresAt is number
        && (!('availability' in request.resource.data) || request.resource.data.availability in ['free', 'maybe', 'busy'])
        && (!('activities' in request.resource.data) || (
          request.resource.data.activities is list
          && request.resource.data.activities.size() <= 2
          && request.resource.data.activities.hasOnly(['game', 'food', 'outing', 'talk', 'sports', 'study', 'other'])
        ))
        && validMusic(request.resource.data);
      allow delete: if isOwner(uid);
    }

    match /codes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.friendCode == code;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /friendRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && exists(/databases/$(database)/documents/users/$(request.resource.data.toUid));
      allow read: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
        && request.resource.data.status in ['accepted', 'declined'];
      allow delete: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /pokes/{pokeId} {
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.kind in ['play', 'game', 'talk', 'cheer']
        && (!('message' in request.resource.data) || (
          request.resource.data.message is string
          && request.resource.data.message.size() >= 1
          && request.resource.data.message.size() <= 60
        ))
        && (!('activity' in request.resource.data) || request.resource.data.activity in ['game', 'food', 'outing', 'talk', 'sports', 'study', 'other'])
        && isFriend(request.resource.data.toUid)
        && !isBlocked(request.resource.data.toUid);
      allow read: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow update: if signedIn() && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
      allow delete: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /notes/{noteId} {
      allow read: if signedIn() || isAdmin();
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 160
        && request.resource.data.expiresAt is number;
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.authorUid == request.auth.uid);
    }

    match /conversations/{conversationId} {
      allow get: if signedIn()
        && request.auth.uid in resource.data.participants
        && isFriend(conversationOther(resource.data));
      // Collection queries cannot safely resolve the dynamic friend document.
      // The required array-contains query still limits results to conversations
      // in which the signed-in user is a participant. Message reads and writes
      // remain friend-only below.
      allow list: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && isFriend(conversationOther(request.resource.data));
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && isFriend(conversationOther(resource.data));
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && isFriend(conversationOther(get(/databases/$(database)/documents/conversations/$(conversationId)).data));
        allow create: if signedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 500
          && request.auth.uid in getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && isFriend(conversationOther(getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data));
        allow update, delete: if false;
      }
    }

    match /groupCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /groups/{groupId} {
      allow get: if isAdmin() || isGroupMember(groupId);
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 20
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() == 6;
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /members/{memberUid} {
        allow read: if isGroupMember(groupId);
        allow create, update: if signedIn()
          && memberUid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && existsAfter(/databases/$(database)/documents/groups/$(groupId));
        allow delete: if signedIn() && (memberUid == request.auth.uid || get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid);
      }

      match /statuses/{statusUid} {
        allow read: if isGroupMember(groupId);
        allow create, update: if isGroupMember(groupId)
          && statusUid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 60
          && request.resource.data.expiresAt is number
          && validMusic(request.resource.data);
        allow delete: if isGroupMember(groupId) && statusUid == request.auth.uid;
      }
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid && request.resource.data.targetUid != request.auth.uid;
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy'])
        && request.resource.data.status in ['resolved', 'dismissed']
        && request.resource.data.reviewedBy == request.auth.uid;
      allow delete: if false;
    }

    match /admins/{uid} {
      allow get: if authenticated() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() && request.resource.data.uid == uid;
      allow update: if isAdmin() && request.resource.data.uid == uid;
      allow delete: if isAdmin() && uid != request.auth.uid;
    }

    match /moderation/{uid} {
      allow get: if authenticated() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && !exists(/databases/$(database)/documents/admins/$(uid))
        && request.resource.data.status in ['active', 'suspended']
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /moderationActions/{actionId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action in ['suspend_user', 'restore_user', 'delete_note', 'resolve_report', 'dismiss_report'];
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
